FROM python:3.11-slim-bookworm

# Minimal Python sandbox environment with audit hook support
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    file \
    strace \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 1001 appgroup && \
    useradd -u 1001 -g appgroup -s /bin/bash -m appuser

WORKDIR /app

# Copy the runner and monitor modules
COPY sandbox/runners /app/runners
COPY monitor /app/monitor

# Ensure non-root ownership
RUN chown -R appuser:appgroup /app

# Create temp directories for sandboxed execution
RUN mkdir -p /tmp/aegis_sandbox && chown -R appuser:appgroup /tmp/aegis_sandbox

USER appuser

# Hardened: run with --security-opt no-new-privileges:true --cap-drop=ALL
ENTRYPOINT ["python3", "/app/runners/python_runner.py"]
